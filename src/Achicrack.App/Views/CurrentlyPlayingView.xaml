<UserControl x:Class="Achicrack.App.Views.CurrentlyPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Achicrack.App.ViewModels"
             xmlns:views="clr-namespace:Achicrack.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CurrentlyPlayingViewModel}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Currently Playing" Style="{StaticResource H1}" Margin="0,0,0,14" />

        <!-- Game summary -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding GameIcon, TargetNullValue={StaticResource DefaultGameImage}}" Width="72" Height="72" VerticalAlignment="Top">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,72,72" RadiusX="10" RadiusY="10" />
                    </Image.Clip>
                </Image>
                <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="{Binding GameName}" FontSize="22" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Margin="7,0,0,0" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding RunningGames}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RunningGameChip}">
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Grid Grid.Column="2" MinWidth="300" Visibility="{Binding HasGame, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Achievements.ProgressText}" Style="{StaticResource StatValue}" Foreground="{StaticResource GoldBrush}" />
                        <TextBlock Text="Achievements" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{Binding Achievements.CompletionText}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Completion" Style="{StaticResource StatLabel}" />
                    </StackPanel>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,10,0,8" Minimum="0" Maximum="100"
                                 Value="{Binding Achievements.CompletionValue, Mode=OneWay}" Foreground="{StaticResource GoldBrush}"
                                 Background="{StaticResource Surface2Brush}" BorderThickness="0" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Muted}">
                        <Run Text="Last achievement: " /><Run Text="{Binding Achievements.LastAchievement, Mode=OneWay, TargetNullValue=—}" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Incomplete catalog warning -->
        <Border DockPanel.Dock="Top" Background="#22F5B841" BorderBrush="#66F5B841" BorderThickness="1" CornerRadius="8" Padding="12,8"
                Margin="0,0,0,12" Visibility="{Binding Achievements.CatalogNote, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Achievements.CatalogNote}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" />
        </Border>

        <Expander DockPanel.Dock="Bottom" Header="Monitored state files" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                  Visibility="{Binding WatchedPaths, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding WatchedPaths}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,6" />
        </Expander>

        <views:AchievementListView DataContext="{Binding Achievements}" />
    </DockPanel>
</UserControl>
