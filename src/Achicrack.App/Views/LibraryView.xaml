<UserControl x:Class="Achicrack.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Achicrack.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Game Library" Style="{StaticResource H1}" />
                <TextBlock Text="Registered games and how Achicrack can monitor them. Game folders are scanned read-only."
                           Style="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Add demo game" Command="{Binding AddDemoGameCommand}" Margin="0,0,8,0" />
                <Button Content="+ Add game" Command="{Binding AddGameCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H2}" Margin="0" />
                    <TextBlock Text="{Binding Selected.InstallDirectory}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Start / stop tracking" Command="{Binding ToggleTrackingCommand}" Margin="0,0,8,0"
                            ToolTip="Manually start or stop monitoring (normally automatic when the game runs)." />
                    <Button Content="Remove" Command="{Binding RemoveGameCommand}" Style="{StaticResource DangerButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <ListBox x:Name="GamesList" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,6,8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon, TargetNullValue={StaticResource DefaultGameImage}}" Width="48" Height="48">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,48,48" RadiusX="8" RadiusY="8" />
                                </Image.Clip>
                            </Image>
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                                    <Run Text="{Binding AppIdText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding MethodText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding AchievementText}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" Foreground="{Binding StatusBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No games registered yet. Click “+ Add game” and select a game folder or executable."
                       Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HasItems, ElementName=GamesList, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
    </DockPanel>
</UserControl>
