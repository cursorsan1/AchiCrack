<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Custom entry point (Program.Main) so startup failures are reported instead of dying silently. -->
    <StartupObject>Achicrack.App.Program</StartupObject>
    <!-- Only used for the system tray NotifyIcon (WPF has no tray API). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Achicrack.App</RootNamespace>
    <AssemblyName>Achicrack</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\achicrack.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003: DPI awareness is declared in app.manifest, which is the correct place for a WPF app. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM source generators (ObservableProperty / RelayCommand). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- LoggerFactory host for the app's structured file logger. -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep its namespaces out of global usings to avoid WPF type clashes. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml must be a Page (not ApplicationDefinition) so WPF does not generate its own Main,
         which would conflict with Program.Main. InitializeComponent is still generated. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Achicrack.Core\Achicrack.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\achicrack.ico" />
    <None Update="Assets\Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
