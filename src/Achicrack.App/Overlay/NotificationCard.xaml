<UserControl x:Class="Achicrack.App.Overlay.NotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:overlay="clr-namespace:Achicrack.App.Overlay"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=overlay:NotificationCardModel}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- PS5-inspired trophy card: dark translucent body, icon left, trophy + caption, bold title, description. -->
    <Grid Margin="18">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Grid.LayoutTransform>
        <Border CornerRadius="16" Background="{Binding BackgroundBrush}" BorderBrush="#33FFFFFF" BorderThickness="1"
                Width="400" MinHeight="88" Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Width="64" Height="64" CornerRadius="10" Background="#2A2F39" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding Icon, TargetNullValue={StaticResource DefaultTrophyImage}}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="10" RadiusY="10" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Path Data="{StaticResource TrophyGeometry}" Fill="{Binding TrophyBrush}" Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding TrophyGlyphVisibility}" />
                        <Path Data="{StaticResource GamepadGeometry}" Fill="{Binding AccentBrush}" Width="15" Height="15" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding GamepadGlyphVisibility}" />
                        <TextBlock Text="{Binding Header}" FontFamily="{Binding FontFamily}" FontSize="12" Foreground="#B8BEC8"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{Binding FontFamily}" FontSize="17" FontWeight="Bold" Foreground="White"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Message}" FontFamily="{Binding FontFamily}" FontSize="13" Foreground="#C8CDD5"
                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               Visibility="{Binding MessageVisibility}" />
                    <TextBlock Text="{Binding RarityText}" FontFamily="{Binding FontFamily}" FontSize="11" Foreground="{Binding TrophyBrush}"
                               Margin="0,4,0,0" Visibility="{Binding RarityVisibility}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
